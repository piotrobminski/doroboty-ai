# Optional, server-only OpenAI integration. Copy to .env.local and set your own key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional local persistence settings. Default requires no configuration.
# DATABASE_PATH=.data/doroboty.sqlite
# Set to 1 only when serving through HTTPS.
AUTH_SECURE_COOKIE=0

# Set a temporary primary administrator password on the server before first provisioning.
AUTH_ADMIN_PASSWORD=

# Optional password recovery. Use local for a private .data outbox on loopback.
# AUTH_RESET_DELIVERY=local
# AUTH_RESET_ORIGIN=http://localhost:3001
# Use email with your HTTPS site origin, verified sender and Resend key.
# AUTH_RESET_EMAIL_FROM=
# AUTH_RESET_RESEND_KEY=

# Optional PostHog Cloud event counts. Use the write-only Project Token for this prototype.
# POSTHOG_PROJECT_TOKEN=
# POSTHOG_REGION=eu
